{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TempoBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::${TEMPO_S3_BUCKET_NAME}"
    },
    {
      "Sid": "TempoObjectReadWriteDelete",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:GetObjectTagging", "s3:PutObjectTagging"],
      "Resource": "arn:aws:s3:::${TEMPO_S3_BUCKET_NAME}/*"
    }
  ]
}
