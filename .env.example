# Copy to .env and fill in. Never commit .env.

# AWS / common
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=

# Network / cluster
EKS_CLUSTER_NAME=petclinic-eks
VPC_ID=
PUBLIC_SUBNET_A_ID=
PUBLIC_SUBNET_C_ID=
APP_PRIVATE_SUBNET_A_ID=
APP_PRIVATE_SUBNET_C_ID=
DB_PRIVATE_SUBNET_A_ID=
DB_PRIVATE_SUBNET_C_ID=

# Domain / edge security
DOMAIN_NAME=
ROUTE53_HOSTED_ZONE_ID=
ACM_CERTIFICATE_ARN=
WAF_WEB_ACL_ARN=

# Container registry
ECR_WEB_REPOSITORY_URI=
ECR_WAS_REPOSITORY_URI=
# Build tag (scripts/build-and-push.sh). Deploy picks per track: stable = current release, canary = candidate.
IMAGE_TAG=
STABLE_IMAGE_TAG=
CANARY_IMAGE_TAG=

# Application / WAS
SPRING_PROFILES_ACTIVE=jpa
JAVA_OPTS="-Xms512m -Xmx1024m"

# Application / Web
WAS_UPSTREAM_HOST=was
WAS_UPSTREAM_PORT=8080

# Database / secrets (in-cluster values come from Secrets Manager via ESO)
# One secret per DB role: admin (db-init), app (was), backup (db-backup). Prefix petclinic/ (ESO IAM scope).
RDS_SECRET_NAME=petclinic/rds
RDS_APP_SECRET_NAME=petclinic/rds-app
RDS_BACKUP_SECRET_NAME=petclinic/rds-backup
RDS_HOST=
RDS_PORT=3306
RDS_DB_NAME=petclinic
JDBC_URL=
JDBC_USERNAME=
JDBC_PASSWORD=
JDBC_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# Observability / backup
CW_LOG_GROUP_NAME=/aws/eks/petclinic-eks/containers
PROMETHEUS_SERVER_URL=http://kube-prometheus-stack-prometheus.monitoring.svc:9090
GRAFANA_ADMIN_SECRET_NAME=petclinic/grafana-admin
# Alertmanager webhook (HTTPS, Slack/PagerDuty/...). Secrets Manager key {"url": ...}, synced by ESO.
ALERTMANAGER_WEBHOOK_SECRET_NAME=petclinic/alertmanager-webhook
# Only read by `provision-aws-resources.sh post-cluster` to create/update that secret; leave empty after.
ALERTMANAGER_WEBHOOK_URL=
BACKUP_S3_BUCKET_NAME=
