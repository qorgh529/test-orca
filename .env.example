# Copy to .env and fill in. Never commit .env.

# AWS / common
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=

# Network / cluster
EKS_CLUSTER_NAME=petclinic-eks
# Pin from: aws eks describe-addon-versions --addon-name aws-ebs-csi-driver --kubernetes-version 1.36
#   --query 'addons[0].addonVersions[0].addonVersion' --output text   (e.g. v1.xx.x-eksbuild.1)
EBS_CSI_ADDON_VERSION=
VPC_ID=
PUBLIC_SUBNET_A_ID=
PUBLIC_SUBNET_C_ID=
APP_PRIVATE_SUBNET_A_ID=
APP_PRIVATE_SUBNET_C_ID=
DB_PRIVATE_SUBNET_A_ID=
DB_PRIVATE_SUBNET_C_ID=

# Domain / edge security
DOMAIN_NAME=
ROUTE53_HOSTED_ZONE_ID=
ACM_CERTIFICATE_ARN=
WAF_WEB_ACL_ARN=

# Container registry
ECR_WEB_REPOSITORY_URI=
ECR_WAS_REPOSITORY_URI=
# Build tag (scripts/build-and-push.sh). Deploy picks per track: stable = current release, canary = candidate.
IMAGE_TAG=
STABLE_IMAGE_TAG=
CANARY_IMAGE_TAG=
# Image builds run on AWS CodeBuild (scripts/build-and-push.sh). Empty = defaults:
#   project ${EKS_CLUSTER_NAME}-image-build, source bucket ${EKS_CLUSTER_NAME}-codebuild-${AWS_ACCOUNT_ID}.
CODEBUILD_PROJECT_NAME=
CODEBUILD_S3_BUCKET_NAME=
# Image to build: all, web or was (default all).
BUILD_TARGET=
# Split opened by deploy-all.sh after the canary check (empty = 90/10; integers summing to 100).
# Traffic is always held at 100/0 until that check passes. Change it later with scripts/set-canary-weight.sh.
STABLE_WEIGHT=
CANARY_WEIGHT=

# Application / WAS
SPRING_PROFILES_ACTIVE=jpa
JAVA_OPTS="-Xms512m -Xmx1024m"

# Application / Web
WAS_UPSTREAM_HOST=was
WAS_UPSTREAM_PORT=8080

# Database / secrets (in-cluster values come from Secrets Manager via ESO)
# One secret per DB role: admin (db-init), app (was), backup (db-backup). Prefix petclinic/ (ESO IAM scope).
RDS_SECRET_NAME=petclinic/rds
RDS_APP_SECRET_NAME=petclinic/rds-app
RDS_BACKUP_SECRET_NAME=petclinic/rds-backup
RDS_HOST=
RDS_PORT=3306
RDS_DB_NAME=petclinic
JDBC_URL=
JDBC_USERNAME=
JDBC_PASSWORD=
JDBC_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# Observability / backup
CW_LOG_GROUP_NAME=/aws/eks/petclinic-eks/containers
PROMETHEUS_SERVER_URL=http://kube-prometheus-stack-prometheus.monitoring.svc:9090
GRAFANA_ADMIN_SECRET_NAME=petclinic/grafana-admin
# Alertmanager webhook (HTTPS, Slack/PagerDuty/...). Secrets Manager key {"url": ...}, synced by ESO.
ALERTMANAGER_WEBHOOK_SECRET_NAME=petclinic/alertmanager-webhook
# Only read by `provision-aws-resources.sh post-cluster` to create/update that secret; leave empty after.
ALERTMANAGER_WEBHOOK_URL=
BACKUP_S3_BUCKET_NAME=

# Tracing (OpenTelemetry + Tempo). Tempo has its own bucket, never the backup bucket.
TEMPO_S3_BUCKET_NAME=
# Days Tempo keeps traces: S3 lifecycle expiry and Tempo block retention (deploy-all.sh renders it as hours).
TEMPO_RETENTION_DAYS=14
# Head sampling ratio for the Java agent (parentbased_traceidratio), 0.0-1.0.
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_DEPLOYMENT_ENVIRONMENT=production

# Daily stop/start (scripts/daily-stop.sh, scripts/daily-start.sh). Empty = defaults.
# RDS instance to stop/start (default: ${EKS_CLUSTER_NAME}-mysql).
RDS_INSTANCE_ID=
# Node group size restored when .daily-nodegroup-state.json has no entry (default 2, like infra/eksctl/cluster.yaml).
# NG_CRITICAL_MIN_SIZE / NG_CRITICAL_MAX_SIZE (and NG_PLATFORM_*) may also be set; defaults 2 / 4.
NG_CRITICAL_DESIRED_SIZE=
NG_PLATFORM_DESIRED_SIZE=
